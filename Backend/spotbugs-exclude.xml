<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Ignore EI_EXPOSE_REP / EI_EXPOSE_REP2 for all entity and DTO classes since Lombok generates getters/setters for them -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    
    <!-- Ignore Finalizer attacks warning on constructors that throw exceptions -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
</FindBugsFilter>
